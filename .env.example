# Application Configuration
APP_NAME=IncidentIQ
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API
API_V1_STR=/api/v1
SECRET_KEY=change-this-super-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incidentiq
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incidentiq

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider (Ollama Local Zero-Cost Provider)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Cloud / External API Keys
GROK_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=
